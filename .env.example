# ── Required ────────────────────────────────────────────────────────────────
# Your Anthropic API key (server-side only — never ships to the browser).
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Recommended ─────────────────────────────────────────────────────────────
# Shared secret to protect the manual POST /api/refresh endpoint.
# Generate any long random string.
REFRESH_TOKEN=change-me-to-a-long-random-string

# Restrict who may call the API from the browser. Use your site's origin in
# production, e.g. https://www.autohaus-pufahl.de  (use * only while testing).
ALLOWED_ORIGIN=*

# ── Optional (sensible defaults) ─────────────────────────────────────────────
# Port the server listens on.
PORT=8080

# How often to re-scrape mobile.de (cron syntax, Europe/Berlin time).
# Default: every 6 hours. Keep it infrequent — be a polite scraper.
CRON_SCHEDULE=0 */6 * * *

# The dealer's mobile.de page and how many listing pages to read.
DEALER_URL=https://home.mobile.de/AH-PUFAHL
MAX_PAGES=2

# Extraction model. Haiku is fast + cheap and more than enough here.
ANTHROPIC_MODEL=claude-haiku-4-5

# mobile.de image size rule used to build photo URLs (mo-360 … mo-1600).
IMG_RULE=mo-1600
